# ============================================================================
# STATISTICAL HELPERS
# ============================================================================


def _weighted_ols(
    xs: list[float], ys: list[float], weights: list[float]
) -> tuple[float, float]:
    total_weight: float = sum(weights)
    if total_weight <= 0:
        return 0.0, (sum(ys) / len(ys) if ys else 0.0)

    mean_x: float = sum(w * x for w, x in zip(weights, xs)) / total_weight
    mean_y: float = sum(w * y for w, y in zip(weights, ys)) / total_weight

    numerator: float = sum(w * (x - mean_x) * (y - mean_y) for w, x, y in zip(weights, xs, ys))
    denominator: float = sum(w * (x - mean_x) ** 2 for w, x in zip(weights, xs))

    if denominator == 0:
        return 0.0, mean_y

    slope: float = numerator / denominator
    intercept: float = mean_y - slope * mean_x
    return slope, intercept


def _mean(values: list[float]) -> float:
    return sum(values) / len(values) if values else 0.0


def _sample_covariance(xs: list[float], ys: list[float]) -> float:
    if len(xs) < 2:
        return 0.0
    mean_x, mean_y = _mean(xs), _mean(ys)
    return sum((x - mean_x) * (y - mean_y) for x, y in zip(xs, ys)) / (len(xs) - 1)


def _sample_variance(xs: list[float]) -> float:
    return _sample_covariance(xs, xs)


